#!/usr/bin/env bun

import { main, resolveAriLaunchContext } from "../src/cli.ts";

const args = process.argv.slice(2);
const launch = resolveAriLaunchContext(process.cwd(), process.env);
process.exitCode = await main(args.length === 0 ? ["pane"] : args, {
  cwd: launch.projectDir,
  env: launch.env,
  stdout: process.stdout,
  stderr: process.stderr,
});
